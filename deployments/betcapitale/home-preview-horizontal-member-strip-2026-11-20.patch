+import { useEffect, useRef, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { Link } from "wouter";
+import { ArrowRight, TrendingUp, Users } from "lucide-react";
+import "./horizontal-member-strip.css";
+
+interface CommunityStats {
+  totalMembers: number;
+  currentlyActive: number;
+  todayIncrease: number;
+  weekIncrease: number;
+}
+const DIGIT_COUNT = 4;
+
+function useAnimatedMembers(value: number | null) {
+  const [display, setDisplay] = useState<number | null>(null);
+  const lastRef = useRef<number | null>(null);
+  useEffect(() => {
+    if (value === null) return;
+    const start = lastRef.current ?? 0;
+    const end = Math.max(0, Math.floor(value));
+    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+    if (reduced || start === end) {
+      lastRef.current = end;
+      setDisplay(end);
+      return;
+    }
+    const started = performance.now();
+    const duration = 1100;
+    let handle = 0;
+    const tick = (time: number) => {
+      const p = Math.min((time - started) / duration, 1);
+      const eased = 1 - Math.pow(1 - p, 3);
+      setDisplay(Math.round(start + (end - start) * eased));
+      if (p < 1) handle = requestAnimationFrame(tick);
+      else lastRef.current = end;
+    };
+    handle = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(handle);
+  }, [value]);
+  return display;
+}
+
+function MemberDigits({ value }: { value: number | null }) {
+  const digits = value === null
+    ? Array.from({ length: DIGIT_COUNT }, () => "–")
+    : Math.max(0, value).toString().padStart(DIGIT_COUNT, "0").split("");
+  return (
+    <div className="cms-digits" aria-label={value === null ? "Loading member total" : `${value.toLocaleString("en-GB")} total members`}>
+      {digits.map((digit, index) => (
+        <span className="cms-digit" aria-hidden="true" key={index}>{digit}</span>
+      ))}
+    </div>
+  );
+}
+
+export default function HorizontalMemberStrip() {
+  const { data, isLoading } = useQuery<CommunityStats>({
+    queryKey: ["/api/community/stats"],
+    refetchInterval: 15000,
+  });
+  const displayed = useAnimatedMembers(
+    typeof data?.totalMembers === "number" ? data.totalMembers : null
+  );
+  const stats = [
+    { label: "Currently active", key: "active", value: data?.currentlyActive, prefix: "", icon: "active" },
+    { label: "Today", key: "today", value: data?.todayIncrease, prefix: "+", icon: "up" },
+    { label: "This week", key: "week", value: data?.weekIncrease, prefix: "+", icon: "up" },
+  ] as const;
+
+  return (
+    <section className="capitale-members-strip" aria-label="CAPITALE community membership">
+      <div className="cms-total">
+        <div className="cms-label">
+          <span className="cms-people-icon"><Users size={17} strokeWidth={1.8} /></span>
+          <div>
+            <strong>Total Bet Capitale Members</strong>
+            <small>OUR GROWING COMMUNITY</small>
+          </div>
+        </div>
+        <MemberDigits value={displayed} />
+      </div>
+
+      <div className="cms-stats">
+        {stats.map((item) => (
+          <div className="cms-stat" key={item.key}>
+            <div className="cms-stat-label">
+              {item.icon === "active"
+                ? <span className="cms-live-dot" aria-hidden="true" />
+                : <TrendingUp size={12} strokeWidth={2.1} aria-hidden="true" />}
+              <span>{item.label}</span>
+            </div>
+            <div className={`cms-stat-number ${item.key === "active" ? "" : "cms-highlight"}`}>
+              {typeof item.value === "number"
+                ? `${item.prefix}${item.value.toLocaleString("en-GB")}`
+                : "—"}
+            </div>
+          </div>
+        ))}
+      </div>
+
+      <div className="cms-action">
+        <Link href="/plans" className="cms-join" data-testid="button-live-community-cta">
+          Join the Community <ArrowRight size={15} aria-hidden="true" />
+        </Link>
+        <p>{isLoading ? "Loading live membership data" : "Member count updates throughout the day"}</p>
+      </div>
+    </section>
+  );
+}
