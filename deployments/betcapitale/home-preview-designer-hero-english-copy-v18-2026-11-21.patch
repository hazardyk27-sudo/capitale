+/* CAPITALE Preview v18 — user-approved new English marketing headline.
+   Keep the existing serif family, orange/ink palette, CTA alignment, animated
+   software scene and counter. Responsively fit the longer English headline. */
+.capitale-hero-tagline {
+  display:block;
+  font-family:inherit;
+  font-weight:700;
+  line-height:1.45;
+  color:#0E1726;
+}
+.capitale-hero-support {
+  display:block;
+  font-family:inherit;
+  margin-top:8px;
+  line-height:1.48;
+  color:#5F6673;
+}
+@media(min-width:1360px){
+  .desktopHome .hero-grid.capitale-preview-hero.capitale-with-intelligence-flow .hero-headline {
+    font-size:clamp(58px,4.0vw,68px);
+    line-height:1.05;
+    letter-spacing:-.024em;
+  }
+}
+@media(min-width:1180px) and (max-width:1359px){
+  .desktopHome .hero-grid.capitale-preview-hero.capitale-with-intelligence-flow .hero-headline {
+    font-size:clamp(49px,4vw,54px);
+    line-height:1.05;
+    letter-spacing:-.024em;
+  }
+}
+@media(min-width:768px) and (max-width:1179px){
+  .desktopHome .hero-grid.capitale-preview-hero.capitale-with-intelligence-flow .hero-headline{
+    font-size:clamp(48px,4.8vw,60px);
+    line-height:1.05;
+  }
+}
+@media(max-width:767px){
+  .bc-mobile-title{
+    font-size:clamp(28px,8vw,34px);
+    line-height:1.08;
+  }
