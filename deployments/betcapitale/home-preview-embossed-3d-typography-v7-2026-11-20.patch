--- a/client/src/components/daily-profit-ticker-demo.css
+++ b/client/src/components/daily-profit-ticker-demo.css
@@ -344,3 +344,41 @@
   .dpt-date strong { font-size: 10px; }
   .dpt-number strong { font-size: 15px; }
 }
+
+/* CAPITALE v7 — restrained, embossed type to complement the v6 raised black cards.
+   No geometry, motion, content, or card-surface modifications. */
+.dpt-date strong,
+.dpt-number strong {
+  text-shadow:
+    0 -1px 0 rgba(255,255,255,.19),
+    0 1px 0 rgba(0,0,0,.9),
+    0 2px 2px rgba(0,0,0,.56),
+    0 4px 5px rgba(0,0,0,.18);
+  -webkit-font-smoothing: antialiased;
+}
+.dpt-profit-amount {
+  text-shadow:
+    0 -1px 0 rgba(255,255,255,.17),
+    0 1px 0 rgba(0,0,0,.85),
+    0 2px 3px rgba(0,0,0,.68);
+  -webkit-font-smoothing: antialiased;
+}
+.dpt-profit-line svg {
+  filter: drop-shadow(0 1px 1px rgba(0,0,0,.65));
+}
+.dpt-date > span,
+.dpt-number span,
+.dpt-profit-status {
+  text-shadow:
+    0 1px 1px rgba(0,0,0,.88),
+    0 -1px 0 rgba(255,255,255,.035);
+}
+@media (max-width: 355px) {
+  .dpt-date strong,
+  .dpt-number strong {
+    text-shadow:
+      0 -1px 0 rgba(255,255,255,.13),
+      0 1px 0 rgba(0,0,0,.85),
+      0 2px 2px rgba(0,0,0,.42);
+  }
+}
