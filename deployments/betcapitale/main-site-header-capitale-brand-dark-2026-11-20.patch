+/** Shared dark-mode variant of the approved Software Intelligence header identity. */
+export function CapitaleHeaderBrand({ compact = false }: { compact?: boolean }) {
+  return (
+    <span
+      className="capitale-header-brand"
+      style={{
+        display: "inline-flex",
+        alignItems: "center",
+        gap: compact ? "9px" : "12px",
+        flexShrink: 0,
+        whiteSpace: "nowrap",
+        lineHeight: 1,
+      }}
+    >
+      <img
+        src="/capitale-premium-symbol.svg"
+        alt=""
+        aria-hidden="true"
+        width={compact ? 33 : 36}
+        height={compact ? 33 : 36}
+        style={{
+          display: "block",
+          width: compact ? "33px" : "36px",
+          height: compact ? "33px" : "36px",
+          objectFit: "contain",
+          flexShrink: 0,
+        }}
+      />
+      <span style={{ display: "flex", flexDirection: "column", alignItems: "flex-start", minWidth: 0 }}>
+        <strong
+          style={{
+            display: "block",
+            color: "#FFFFFF",
+            fontFamily: 'Georgia, "Times New Roman", serif',
+            fontSize: compact ? "17px" : "19px",
+            letterSpacing: compact ? "0.15em" : "0.18em",
+            lineHeight: 1.15,
+            fontWeight: 600,
+            whiteSpace: "nowrap",
+          }}
+        >
+          CAPITALE
+        </strong>
+        <small
+          style={{
+            display: "block",
+            marginTop: compact ? "5px" : "6px",
+            color: "#C9CED7",
+            fontFamily: '"Manrope", Arial, sans-serif',
+            fontSize: compact ? "7px" : "8px",
+            fontWeight: 750,
+            letterSpacing: compact ? "0.14em" : "0.20em",
+            lineHeight: 1.25,
+            whiteSpace: "nowrap",
+          }}
+        >
+          SOFTWARE INTELLIGENCE
+        </small>
+      </span>
+    </span>
+  );
+}
