+import test from "node:test";
+import assert from "node:assert/strict";
+import { normalizeSoftwareDetailBullets, SOFTWARE_DEPARTMENT_ORDER } from "./software-details";
+
+test("department reveal sequence is SXF then NEWS then ANALYST", () => {
+  assert.deepEqual(SOFTWARE_DEPARTMENT_ORDER, ["sxf", "news", "analyst"]);
+});
+
+test("at most three English summary bullets are rendered", () => {
+  assert.deepEqual(normalizeSoftwareDetailBullets([" A. ", "B.", "C.", "D.", "E."]), ["A.", "B.", "C."]);
+});
+
+test("missing, malformed, and whitespace-only summary items are excluded", () => {
+  assert.deepEqual(normalizeSoftwareDetailBullets(null), []);
+  assert.deepEqual(normalizeSoftwareDetailBullets({ text: "not an array" }), []);
+  assert.deepEqual(normalizeSoftwareDetailBullets([null, false, "", "  ", "Evidence.", 7]), ["Evidence."]);
+});
+
+test("summary validation does not mutate the agent's report payload", () => {
+  const original = ["First", "Second", "Third", "Fourth"];
+  const copy = [...original];
+  assert.equal(normalizeSoftwareDetailBullets(original).length, 3);
+  assert.deepEqual(original, copy);
+});
