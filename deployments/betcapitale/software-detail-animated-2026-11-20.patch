+/** Ordered, evidence-only presentation contract for the CAPITALE Software detail drawer. */
+export const SOFTWARE_DEPARTMENT_ORDER = ["sxf", "news", "analyst"] as const;
+
+/** Defensive render cap: malformed payloads cannot create more than 3 visible bullets. */
+export function normalizeSoftwareDetailBullets(input: unknown): string[] {
+  if (!Array.isArray(input)) return [];
+  return input
+    .filter((item): item is string => typeof item === "string" && item.trim().length > 0)
+    .map((item) => item.trim())
+    .slice(0, 3);
+}
