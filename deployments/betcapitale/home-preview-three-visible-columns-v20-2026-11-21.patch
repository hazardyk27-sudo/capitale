 }
+
+/* V20 — original 3-column premium console, all contents present in every phase.
+   Active emphasis ONLY; never conditional-hide adjacent cards. */
+.cif-console.cif-console-v20 {
+  height:195px;
+  display:flex;
+  flex-direction:column;
+  min-height:0;
+  box-sizing:border-box;
+  overflow:hidden;
+  border-radius:17px;
+}
+.cif-console-v20 .cif-console-heading{
+  height:29px;
+  flex:0 0 29px;
+  box-sizing:border-box;
+  padding:0 13px;
+}
+.cif-console-v20 .cif-console-caption{font-size:7.5px;white-space:nowrap;}
+.cif-v20-grid{
+  box-sizing:border-box;
+  display:grid;
+  grid-template-columns:repeat(3,minmax(0,1fr));
+  min-height:0;
+  flex:1 1 auto;
+  background:linear-gradient(180deg,#FAFCFF,#F3F7FC);
+}
+.cif-v20-column{
+  box-sizing:border-box;
+  display:flex;flex-direction:column;position:relative;min-width:0;min-height:0;
+  background:linear-gradient(165deg,rgba(255,255,255,.96),rgba(246,249,253,.92));
+  transition:background .28s,box-shadow .28s;
+}
+.cif-v20-column+.cif-v20-column{border-left:1px solid #DEE6F0;}
+.cif-v20-column.is-active{
+  background:linear-gradient(145deg,#FFFFFF 0%,#FFFBF7 62%,#FAF5F0 100%);
+  box-shadow:inset 0 2px rgba(232,119,31,.26);
+}
+.cif-v20-head{
+  all:unset; box-sizing:border-box;cursor:pointer;
+  width:100%;min-height:31px;flex:0 0 31px;
+  display:flex;align-items:center;justify-content:space-between;gap:5px;
+  padding:0 10px;
+  font:900 10px "Manrope",Arial,sans-serif;
+  color:#23344C;
+  border-bottom:1px solid #E4EAF2;
+  -webkit-tap-highlight-color:transparent;
+}
+.cif-v20-head:focus-visible{outline:2px solid #E8771F;outline-offset:-3px;}
+.cif-v20-head svg{margin-left:auto;flex:0 0 auto;color:#7E91AB;}
+.cif-v20-step{font-weight:950;font-size:9px;color:#E8771F;}
+.cif-v20-title{font-size:10.5px;font-weight:950;letter-spacing:.02em;}
+.cif-v20-column.is-active .cif-v20-title{color:#101E30;}
+.cif-v20-body{
+  min-height:0;display:flex;flex-direction:column;box-sizing:border-box;
+  flex:1 1 auto;padding:2px 10px 5px;overflow:hidden;
+}
+.cif-v20-match{
+  box-sizing:border-box;display:flex;align-items:center;gap:6px;min-width:0;
+  flex:1 1 0;border-bottom:1px solid #EAEFF5;
+}
+.cif-v20-match:last-child{border-bottom:0;}
+.cif-v20-id{
+  flex:0 0 auto;padding:3px 2px;border-radius:4px;
+  font-size:7px;font-weight:850;letter-spacing:-.02em;color:#96A3B6;background:#F3F6FA;
+}
+.cif-v20-entry{min-width:0;display:flex;flex-direction:column;justify-content:center;gap:1px;}
+.cif-v20-entry strong{
+  display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
+  font-size:9.3px;line-height:1.2;font-weight:850;color:#2B3A50;
+}
+.cif-v20-entry small{
+  display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
+  font-size:8.2px;line-height:1.25;font-weight:750;color:#BA753E;
+}
+.cif-v20-coupon{
+  display:flex;min-height:0;min-width:0;align-items:center;
+  flex:1 1 0;border-bottom:1px solid #EAEFF5;
+}
+.cif-v20-coupon .cif-v20-entry{width:100%;}
+.cif-v20-coupon .cif-v20-entry strong{display:flex;align-items:center;gap:3px;justify-content:space-between;}
+.cif-v20-coupon .cif-v20-entry em{font-size:9.2px;color:#24364E;font-style:normal;}
+.cif-v20-coupon .cif-v20-entry small{font-size:8px;color:#8494A9;}
+.cif-v20-stake-note{
+  flex:0 0 auto;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
+  color:#A27656;font-size:7.6px;font-weight:800;letter-spacing:.016em;
+}
+.cif-v20-results-list{padding-left:10px;padding-right:10px;}
+.cif-v20-result{
+  display:flex;align-items:center;justify-content:space-between;gap:3px;min-width:0;
+  flex:1 1 0;border-bottom:1px solid #EAEFF5;
+}
+.cif-v20-result span{color:#596B84;font-size:8.7px;font-weight:850;white-space:nowrap;}
+.cif-v20-result strong{font-size:11.2px;font-weight:950;white-space:nowrap;font-variant-numeric:tabular-nums;}
+.cif-v20-win{color:#1A9A72;}
+.cif-v20-loss{color:#CC665E;}
+.cif-v20-totals{
+  flex:0 0 auto;box-sizing:border-box;margin-top:3px;
+  padding:5px 6px 4px;border-radius:6px;
+  background:linear-gradient(165deg,#FFFDFC,#FFF4EA);
+  border:1px solid rgba(232,119,31,.14);
+  display:flex;flex-direction:column;gap:1px;
+}
+.cif-v20-totals small{font-size:7.2px;font-weight:800;color:#8B99AB;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
+.cif-v20-totals strong{font-size:10.5px;line-height:1.14;font-weight:950;color:#25374D;white-space:nowrap;}
+.cif-v20-totals strong span{color:#1A9A72;}
+.cif-v20-progress{
+  height:2px;position:absolute;left:0;right:0;bottom:0;
+  background:#E3EAF4;overflow:hidden;
+}
+.cif-v20-progress span{position:absolute;inset:0;background:linear-gradient(90deg,#E8771F,#FFAB6D);transform:scaleX(0);transform-origin:left;}
+.cif-v20-column.is-active .cif-v20-progress span{animation:cif-v20-progress-fill 6.6s linear forwards;}
+.cif-console-v20[data-flow-phase="results"] .cif-v20-column.is-active .cif-v20-progress span{animation-duration:7.8s;}
+@keyframes cif-v20-progress-fill{to{transform:scaleX(1)}}
+.cif-v20-footer{
+  box-sizing:border-box;display:flex;justify-content:space-between;align-items:center;gap:8px;
+  flex:0 0 24px;height:24px;min-height:0;padding:0 12px;
+  border-top:1px solid #DEE6F0;
+  background:linear-gradient(180deg,#FAFCFF,#F1F5FA);
+  font-size:7.6px;color:#8494AA;font-weight:800;white-space:nowrap;
+}
+.cif-v20-footer>span{display:inline-flex;align-items:center;gap:5px;}
+.cif-v20-footer svg{color:#E8771F;flex:0 0 auto;}
+.cif-v20-status{color:#B87948;}
