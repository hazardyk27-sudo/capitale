 @media(prefers-reduced-motion:reduce){
  .cif-v20-column.is-active .cif-v20-progress span{animation:none;transform:scaleX(1);}
 }
+
+/* V21 — Three horizontal workflows. Never hide any process or content.
+   Spread data across the full console width instead of squeezing 3 tables. */
+.cif-console.cif-console-v21{
+  box-sizing:border-box;display:flex;flex-direction:column;
+  height:246px;min-height:0;overflow:hidden;border-radius:17px;
+  border-color:#D8E1EC;
+  box-shadow:0 2px 2px rgba(27,43,63,.025),0 8px 15px rgba(27,43,63,.055),
+     0 19px 32px rgba(27,43,63,.13),inset 0 1px rgba(255,255,255,.97);
+}
+.cif-console-v21 .cif-console-heading{
+  height:27px;flex:0 0 27px;padding:0 12px;box-sizing:border-box;
+  background:linear-gradient(180deg,#FFF,#F7F9FC);
+}
+.cif-console-v21 .cif-console-title{font-size:9.5px;}
+.cif-console-v21 .cif-console-caption{font-size:7.5px;letter-spacing:.02em;white-space:nowrap;}
+.cif-v21-lanes{
+  display:flex;flex:1 1 auto;flex-direction:column;min-height:0;
+  background:linear-gradient(180deg,#FDFEFF,#F4F7FC);
+}
+.cif-v21-lane{
+  position:relative;box-sizing:border-box;display:grid;
+  grid-template-columns:94px minmax(0,1fr);align-items:stretch;column-gap:5px;
+  min-height:0;flex:1 1 0;padding:5px 7px;
+  border-bottom:1px solid #E4EAF2;
+  background:linear-gradient(100deg,#FFFFFF,#F7F9FD);
+  transition:background .3s ease,box-shadow .3s ease;
+}
+.cif-v21-lane-matches{flex-grow:1.15;}
+.cif-v21-lane-results{flex-grow:1.16;}
+.cif-v21-lane.is-active{
+  background:linear-gradient(100deg,#FFFEFC 0%,#FFFBF7 44%,#F9FBFE 100%);
+  box-shadow:inset 3px 0 #E8771F,inset 0 1px rgba(255,255,255,.85);
+}
+.cif-v21-stagebtn{
+  all:unset;box-sizing:border-box;width:100%;min-width:0;
+  display:flex;flex-direction:column;justify-content:center;align-items:flex-start;
+  gap:2px;cursor:pointer;padding:2px 6px 2px 4px;
+  border-right:1px solid #E2E9F2;
+  font-family:"Manrope",Arial,sans-serif;
+  -webkit-tap-highlight-color:transparent;
+}
+.cif-v21-stagebtn:focus-visible{outline:2px solid #E8771F;outline-offset:-2px;}
+.cif-v21-ordinal{color:#E8771F;font-size:8px;font-weight:950;letter-spacing:.02em;}
+.cif-v21-stagebtn strong{color:#273851;font-size:11px;line-height:1.12;font-weight:950;letter-spacing:.035em;}
+.cif-v21-stagebtn small{color:#8C99AC;font-size:8px;line-height:1.1;font-weight:750;}
+.cif-v21-tiles{box-sizing:border-box;display:grid;align-items:stretch;min-width:0;min-height:0;gap:5px;}
+.cif-v21-match-tiles,.cif-v21-result-tiles{grid-template-columns:repeat(4,minmax(0,1fr));}
+.cif-v21-coupon-tiles{grid-template-columns:repeat(3,minmax(0,1fr));}
+.cif-v21-tile{
+  box-sizing:border-box;min-width:0;min-height:0;overflow:hidden;
+  display:flex;flex-direction:column;justify-content:center;
+  gap:3px;padding:4px 7px;border-radius:8px;
+  background:linear-gradient(155deg,#FFFFFF,#F7FAFE);
+  border:1px solid #E0E7F0;
+  box-shadow:0 1px 1px rgba(27,43,63,.025),inset 0 1px #FFFFFF;
+}
+.cif-v21-lane.is-active .cif-v21-tile{
+  border-color:#E7DFD6;
+  box-shadow:0 1px 2px rgba(27,43,63,.055),inset 0 1px #FFFFFF;
+}
+.cif-v21-tile-top{
+  display:flex;min-width:0;gap:3px;align-items:center;justify-content:space-between;
+}
+.cif-v21-tile-top strong{
+  font-size:9.25px;color:#23344C;font-weight:900;line-height:1.13;
+  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
+}
+.cif-v21-match .cif-v21-tile-top{align-items:flex-start;gap:4px;}
+.cif-v21-match .cif-v21-tile-top strong{font-size:9px;letter-spacing:-.015em;min-width:0;}
+.cif-v21-match-code{
+  box-sizing:border-box;flex:0 0 auto;color:#8E9DB1;
+  font-size:7px;font-weight:850;padding:1px 0;
+}
+.cif-v21-selection{
+  display:block;color:#B86E36;font-size:8.5px;line-height:1.25;font-weight:850;
+  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
+  margin-left:21px;
+}
+.cif-v21-coupon .cif-v21-tile-top strong{font-size:10.2px;}
+.cif-v21-coupon .cif-v21-tile-top span{
+  color:#E8771F;font-size:10px;font-weight:950;white-space:nowrap;
+  font-variant-numeric:tabular-nums;
+}
+.cif-v21-coupon small{
+  color:#8291A4;font-size:8.7px;font-weight:750;line-height:1.3;
+  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
+}
+.cif-v21-result .cif-v21-tile-top strong{font-size:8.8px;}
+.cif-v21-result .cif-v21-tile-top span{
+  font-size:7.8px;font-weight:950;white-space:nowrap;letter-spacing:.01em;
+}
+.cif-v21-won{color:#209F79;}
+.cif-v21-lost{color:#CF6F64;}
+.cif-v21-result>strong{
+  font-size:15px;font-weight:950;line-height:1.08;
+  letter-spacing:-.02em;font-variant-numeric:tabular-nums;
+  text-shadow:0 1px rgba(255,255,255,.72);
+}
+.cif-v21-money-win{color:#138B64;}
+.cif-v21-money-loss{color:#C75C56;}
+.cif-v21-net{
+  background:linear-gradient(145deg,#172031,#111823)!important;
+  border-color:#323D4D!important;gap:2px;
+  box-shadow:0 2px 6px rgba(22,32,48,.13),inset 0 1px rgba(255,255,255,.10)!important;
+}
+.cif-v21-net>span{font-size:7.5px;font-weight:900;letter-spacing:.045em;color:#ADB8C9;white-space:nowrap;}
+.cif-v21-net>strong{font-size:16px;line-height:1.0;font-weight:950;color:#7AE0AB;font-variant-numeric:tabular-nums;}
+.cif-v21-net>small{
+  font-size:7.1px;color:#B2C0D2;font-weight:800;
+  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
+}
+.cif-v21-active-line{
+  position:absolute;left:0;right:0;bottom:0;height:2px;
+  background:linear-gradient(90deg,#E8771F,#FFB578);
+  transform:scaleX(0);transform-origin:left;pointer-events:none;
+}
+.cif-v21-lane.is-active .cif-v21-active-line{animation:cif-v21-scan 6.6s linear forwards;}
+.cif-console-v21[data-flow-phase="results"] .cif-v21-lane.is-active .cif-v21-active-line{animation-duration:7.8s;}
+@keyframes cif-v21-scan{to{transform:scaleX(1)}}
+.cif-v21-footer{
+  display:flex;box-sizing:border-box;align-items:center;justify-content:space-between;
+  gap:6px;flex:0 0 21px;height:21px;padding:0 11px;min-height:0;
+  color:#8290A4;background:linear-gradient(180deg,#FBFCFE,#F3F6FA);
+  font-size:7.4px;font-weight:800;letter-spacing:.015em;white-space:nowrap;
+}
+.cif-v21-footer>span{display:flex;align-items:center;gap:5px;min-width:0;}
+.cif-v21-footer svg{color:#E8771F;flex:0 0 auto;}
+.cif-v21-status{color:#B47540;}
