+/** Offline deterministic illustrative fallback, NEVER an SXF metric or decision.
+ * Only display components may call this helper. It makes no API / DB writes.
+ * Both Software and Social use this SAME algorithm compiled from this file. */
+export type SampleFixture = {date?: string | null, homeTeam?: string | null, awayTeam?: string | null};
+export type SampleVisual = {signal:string, checkpoint:string, analyst:string, volume:string, news:string, draw:string, movement:string};
+export const CAPITALE_SAMPLE_SIGNALS = ['PRM-6','MOM-8','STR-6','SLD-8','CRL-6','CNI-6','PRM-8'] as const;
+export function capitaleSampleVisual(match:SampleFixture):SampleVisual {
+  const normalize=(s:string)=>s.normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim().replace(/\s+/g,' ');
+  const text='capitale-sample-v1|'+(match.date||'')+'|'+normalize(match.homeTeam||'')+'|'+normalize(match.awayTeam||'');
+  let hash=2166136261;
+  for(let i=0;i<text.length;i++)hash=Math.imul(hash^text.charCodeAt(i),16777619)>>>0;
+  const pick=(salt:number,lo:number,hi:number)=>{
+    let n=(hash^Math.imul(salt,2654435761))>>>0;
+    n=Math.imul(n^(n>>>16),2246822507)>>>0;
+    n=Math.imul(n^(n>>>13),3266489909)>>>0;
+    return lo+n%(hi-lo+1);
+  };
+  const signal=CAPITALE_SAMPLE_SIGNALS[pick(1,0,CAPITALE_SAMPLE_SIGNALS.length-1)];
+  return {
+    signal, checkpoint:signal.endsWith('-8')?'T-8':'T-6',
+    analyst:String(pick(3,61,92)),
+    volume:(pick(4,670,975)/10).toFixed(1)+'%',
+    news:String(pick(5,55,88)),
+    draw:(pick(6,30,215)/10).toFixed(1)+'%',
+    movement:(pick(2,0,1)===0?'-':'+')+(pick(7,2,69)/10).toFixed(1)+'%'
+  };
+}
