@@ -0,0 +1,23 @@
+import {capitaleSampleVisual} from './capitale-visual-fallback';
+import type {MatchList2AutoMetric,MatchList2TodayMatch} from './match-list-v2-auto';
+/** Preserve real Software fields; fill only missing display values; never alter upstream. */
+export function capitaleVisualOverlay(match:MatchList2TodayMatch,verified:MatchList2AutoMetric):MatchList2AutoMetric {
+  const sample=capitaleSampleVisual(match);
+  const sampleFields:string[]=[];
+  const get=(key:keyof typeof sample)=>{
+    const original=verified[key];
+    if(typeof original==='string' && original.trim() && original!=='—')return original;
+    sampleFields.push(key);
+    return sample[key];
+  };
+  const signal=get('signal');
+  const checkpoint=verified.checkpoint?.trim() && verified.signal?.trim()?verified.checkpoint:get('checkpoint');
+  const output={...verified,
+    status:'matched' as const,
+    signal,checkpoint,
+    analyst:get('analyst'),volume:get('volume'),news:get('news'),draw:get('draw'),movement:get('movement'),
+    isIllustrative:sampleFields.length>0,sampleFields,
+    reason:sampleFields.length?`ILLUSTRATIVE SAMPLE: ${sampleFields.join(', ')}`:verified.reason
+  };
+  return output;
+}