@@ -0,0 +1,161 @@
+/** Match List v2 reads *only* the same authorized, source-backed Software API.
+ * Fixture names are not unique globally. The merge is scoped to day, both teams
+ * and (where reliable) kickoff; conflicting market selections always fail closed.
+ * No sample, demo or localStorage numeric value is ever promoted to live data. */
+export type MatchList2TodayMatch = {
+  id: number;
+  date: string;
+  homeTeam: string;
+  awayTeam: string;
+  competition?: string;
+  kickoffAt?: string;
+};
+export type SoftwareMatch2 = {
+  id?: string;
+  date?: string;
+  kickoffAt?: string | null;
+  homeTeam?: string;
+  awayTeam?: string;
+  market?: string | null;
+  selection?: string | null;
+  signalCode?: string | null;
+  checkpointUsed?: string | null;
+  analystScore?: number | null;
+  newsScore?: number | null;
+  volumeShare?: number | null;
+  drawShare?: number | null;
+  currentOdds?: number | null;
+  referenceOdds?: number | null;
+  referenceOddsAt?: string | null;
+  currentOddsAt?: string | null;
+  reportStatus?: string | null;
+  source?: string | null;
+};
+export type AutoStatus = 'matched' | 'missing' | 'ambiguous' | 'unavailable';
+export type MatchList2AutoMetric = {
+  status: AutoStatus;
+  signal: string;
+  checkpoint: string;
+  volume: string;
+  analyst: string;
+  news: string;
+  draw: string;
+  movement: string;
+  selection: string;
+  market: string;
+  reason: string;
+  homeLogoUrl: string | null;
+  awayLogoUrl: string | null;
+};
+export type LogoIndex = Record<string, string>;
+const EMPTY = { signal:'', checkpoint:'', volume:'', analyst:'', news:'', draw:'', movement:'', selection:'', market:'', homeLogoUrl:null, awayLogoUrl:null } as const;
+
+// Strict, explicit club aliases only; no substring/fuzzy match (e.g. Sociedad vs Sociedad B).
+const KNOWN_ALIASES: Record<string,string> = {
+  'leeds united':'leeds',
+  'sheffield wednesday':'sheff wed',
+  'paris saint germain':'paris st g',
+  'paris sg':'paris st g',
+  'magdeburg':'fc magdeburg',
+};
+export function normalizeClub(value: string): string {
+  const key = (value||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'')
+    .toLocaleLowerCase('en').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim().replace(/\s+/g,' ');
+  return KNOWN_ALIASES[key] ?? key;
+}
+export function logoIndexFromManifest(input: unknown): LogoIndex {
+  if (!input || typeof input !== 'object' || Array.isArray(input)) return {};
+  const obj = input as Record<string,unknown>;
+  if (obj.schema !== 'capitale-fixture-crest-coverage-v1' || !obj.logos || typeof obj.logos !== 'object' || Array.isArray(obj.logos)) return {};
+  const output: LogoIndex = {};
+  const collisions = new Set<string>();
+  for (const [name,src] of Object.entries(obj.logos as Record<string,unknown>)) {
+    if (typeof src !== 'string' || !/^\/team-logos\/[a-z0-9-]+\.(?:png|svg)$/.test(src)) continue;
+    const key = normalizeClub(name);
+    if (!key) continue;
+    if (output[key] && output[key] !== src) collisions.add(key);
+    else output[key] = src;
+  }
+  collisions.forEach(collision => { delete output[collision]; });
+  return output;
+}
+function validScore(v: unknown): string {
+  return typeof v==='number' && Number.isFinite(v) && v>=0 && v<=100 ? String(Number(v.toFixed(1))) : '';
+}
+function share(v: unknown): string {
+  const x=validScore(v);return x ? `${x}%` : '';
+}
+function checkpoint(row: SoftwareMatch2): string {
+  const t=row.checkpointUsed?.trim();
+  if (t && /^T-[68]$/.test(t)) return t;
+  const code=row.signalCode?.trim()||'';
+  const m=code.match(/(?:^|-)([68])$/);
+  return m ? `T-${m[1]}` : '';
+}
+function oddsMovement(row: SoftwareMatch2): string {
+  if (!row.market?.trim() || !row.selection?.trim() ||
+      !row.referenceOddsAt || !row.currentOddsAt) return '';
+  const a=Date.parse(row.referenceOddsAt),b=Date.parse(row.currentOddsAt);
+  const old=row.referenceOdds, now=row.currentOdds;
+  if (!Number.isFinite(a)||!Number.isFinite(b)||b<a||
+      typeof old!=='number'||typeof now!=='number'||!Number.isFinite(old)||!Number.isFinite(now)||old<=1||now<=1) return '';
+  const delta=(now-old)*100/old;
+  return `${delta>0?'+':''}${delta.toFixed(1)}%`;
+}
+function softwareDate(row:SoftwareMatch2): string {
+  if (row.date && /^\d{4}-\d{2}-\d{2}$/.test(row.date)) return row.date;
+  if (!row.kickoffAt) return '';
+  const ts=Date.parse(row.kickoffAt);
+  if (!Number.isFinite(ts)) return '';
+  return new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Istanbul',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(ts));
+}
+// `today_matches.kickoff_at` is a display string (often CET) without a
+// timezone; Software uses ISO/UTC. Do not exclude genuine matches by comparing
+// unlabelled wall-clock hours. Duplicate fixtures/markets fail closed below.
+function utcKickoffDate(row:SoftwareMatch2): string {
+  if (!row.kickoffAt) return '';
+  const timestamp=Date.parse(row.kickoffAt);
+  return Number.isFinite(timestamp) ? new Date(timestamp).toISOString().slice(0,10) : '';
+}
+function selectionSignature(row:SoftwareMatch2): string {
+  return [row.market?.trim().toLowerCase()||'',row.selection?.trim().toLowerCase()||'',row.signalCode?.trim().toUpperCase()||''].join('|');
+}
+/** Pure deterministic read-only merge. Logos do not require Software report. */
+export function deriveMatchList2(
+  matches: MatchList2TodayMatch[],
+  software: SoftwareMatch2[],
+  connected: boolean,
+  logoIndex: LogoIndex,
+): Record<number,MatchList2AutoMetric> {
+  const output: Record<number,MatchList2AutoMetric>={};
+  for (const match of matches) {
+    const home=normalizeClub(match.homeTeam),away=normalizeClub(match.awayTeam);
+    const logos={homeLogoUrl:logoIndex[home]??null,awayLogoUrl:logoIndex[away]??null};
+    const unavailable={...EMPTY,...logos,status:'unavailable' as const,reason:'Software source unavailable'};
+    if (!connected) {output[match.id]=unavailable;continue;}
+    const candidates=software.filter(row=>
+      row && (softwareDate(row)===match.date || utcKickoffDate(row)===match.date) &&
+      normalizeClub(row.homeTeam||'')===home && normalizeClub(row.awayTeam||'')===away &&
+      // The API is authoritative: reject demo-only rows even if a browser injects them.
+      !(row.source||'').toUpperCase().includes('SYNTHETIC')
+    );
+    if (!candidates.length){output[match.id]={...EMPTY,...logos,status:'missing',reason:'No verified Software match for this fixture/date'};continue;}
+    const signatures=new Set(candidates.map(selectionSignature));
+    if(signatures.size!==1){output[match.id]={...EMPTY,...logos,status:'ambiguous',reason:'Multiple Software markets/selections; no coupon-selection key to disambiguate'};continue;}
+    // Repeated versions of the same market are only safe if their numerical
+    // values and report state also agree. No silent latest-wins policy.
+    const uniqueValues=new Set(candidates.map(row=>JSON.stringify([
+      row.signalCode,row.checkpointUsed,row.volumeShare,row.analystScore,row.newsScore,
+      row.drawShare,row.referenceOdds,row.currentOdds,row.referenceOddsAt,row.currentOddsAt,row.reportStatus
+    ])));
+    if(uniqueValues.size!==1){output[match.id]={...EMPTY,...logos,status:'ambiguous',reason:'Conflicting Software versions for this fixture/market'};continue;}
+    const row=candidates[0];
+    const code=(row.signalCode||'').trim();
+    output[match.id]={...logos,status:'matched',reason:'From verified Software feed',
+      signal:code==='—'?'':code,checkpoint:checkpoint(row),
+      volume:share(row.volumeShare),analyst:validScore(row.analystScore),news:validScore(row.newsScore),
+      draw:share(row.drawShare),movement:oddsMovement(row),
+      market:row.market||'',selection:row.selection||''};
+  }
+  return output;
+}
