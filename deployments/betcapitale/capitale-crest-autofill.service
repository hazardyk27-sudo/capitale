[Unit]
Description=CAPITALE Match List read-only football crest sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/app/betcapitale/.env
WorkingDirectory=/opt/capitale-crest-autofill-v1
ExecStart=/usr/bin/node /opt/capitale-crest-autofill-v1/crest-autofill.cjs
TimeoutStartSec=360
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/app/betcapitale/dist/public/team-logos /var/lib/capitale-crest-autofill
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
