+import {normalizeClub, type MatchList2AutoMetric, type MatchList2TodayMatch} from './match-list-v2-auto';
+export type PublishedVisual = {
+ signal:string;checkpoint:string;analyst:string;volume:string;news:string;draw:string;movement:string;
+ fieldSource:Record<string,'software'|'illustrative'>;
+};
+export type PublishedSoftwareVisual = {date:string;homeTeam:string;awayTeam:string;market:string|null;selection:string|null;signalCode:string|null;visual:PublishedVisual};
+const KEYS=['signal','analyst','volume','news','draw','movement'] as const;
+/** Exact published Software visual source overrides ONLY fields that were missing
+ * from the live authenticated Software source. Valid real evidence always wins.
+ * Ambiguous or stale public rows never override authenticated data. */
+export function mergePublishedSoftwareVisual(
+ match: MatchList2TodayMatch, verified: MatchList2AutoMetric, fallback: MatchList2AutoMetric,
+ items: PublishedSoftwareVisual[]|undefined,
+):MatchList2AutoMetric {
+ if(verified.status!=='matched'||!Array.isArray(items))return fallback;
+ const matches=items.filter(item => item&&item.date===match.date&&
+   normalizeClub(item.homeTeam)===normalizeClub(match.homeTeam)&&
+   normalizeClub(item.awayTeam)===normalizeClub(match.awayTeam)&&
+   (item.market||'').trim().toLowerCase()===(verified.market||'').trim().toLowerCase()&&
+   (item.selection||'').trim().toLowerCase()===(verified.selection||'').trim().toLowerCase()&&
+   (!verified.signal || verified.signal===item.signalCode));
+ if(matches.length!==1)return fallback;
+ const snapshot=matches[0].visual;
+ if(!snapshot||!snapshot.fieldSource)return fallback;
+ const out:MatchList2AutoMetric={...fallback};
+ const uncertain=new Set<string>(fallback.sampleFields??[]);
+ for(const key of KEYS){
+   const persisted=snapshot[key];
+   if(!uncertain.has(key))continue;
+   // Malformed or incomplete snapshot is never promoted to the UI.
+   if(typeof persisted!=='string'||!persisted.trim()||persisted.length>48)continue;
+   if(!['software','illustrative'].includes(snapshot.fieldSource[key]))continue;
+   out[key]=persisted;
+   if(snapshot.fieldSource[key]==='software')uncertain.delete(key);
+ }
+ if(uncertain.has('checkpoint')&&typeof snapshot.checkpoint==='string'&&/^T-[68]$/.test(snapshot.checkpoint)){
+   out.checkpoint=snapshot.checkpoint;
+   uncertain.delete('checkpoint');
+ }
+ out.sampleFields=Array.from(uncertain);out.isIllustrative=uncertain.size>0;
+ return out;
+}