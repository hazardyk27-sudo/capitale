+}
+function oddsChange(row: SoftwareMatch): number | null {
+  const { currentOdds: now, referenceOdds: before, referenceOddsAt, currentOddsAt } = row;
+  if (!row.market || !row.selection || !referenceOddsAt || !currentOddsAt) return null;
+  const refTime = Date.parse(referenceOddsAt), currentTime = Date.parse(currentOddsAt);
+  if (!Number.isFinite(refTime) || !Number.isFinite(currentTime) || currentTime < refTime) return null;
+  return typeof now === "number" && typeof before === "number" && now > 0 && before > 0
+    ? ((now - before) / before) * 100 : null;
+}
+function deltaInfo(row: SoftwareMatch): { text: string; className: string } {
+  const value = oddsChange(row);
+  if (value === null || !Number.isFinite(value)) return { text: "—", className: "delta-flat" };
+  if (value < 0) return { text: "↓ " + Math.abs(value).toFixed(1) + "%", className: "delta-negative" };
+  if (value > 0) return { text: "↑ " + value.toFixed(1) + "%", className: "delta-positive" };
+  return { text: "0.0%", className: "delta-flat" };
