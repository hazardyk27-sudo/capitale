+function displayMarketPick(market:string|undefined,selection:string|undefined):string {
+  if (!market && !selection) return "";
+  const m=(market||"").trim().toUpperCase();
+  const p=(selection||"").trim().toUpperCase();
+  if (m==="1X2" || m==="FULL TIME" || m==="FULL TIME RESULT") {
+    if (p==="HOME" || p==="1") return "HOME WIN";
+    if (p==="AWAY" || p==="2") return "AWAY WIN";
+    if (p==="DRAW" || p==="X") return "DRAW";
+  }
+  if (m==="BTTS" || m==="BOTH TEAMS TO SCORE") {
+    if (p==="YES" || p==="NO") return `BTTS ${p}`;
+  }
+  if (m.includes("OVER") && /\d+(?:\.\d+)?/.test(m)) return m;
+  return [market,selection].filter(Boolean).join(" · ");
+}
