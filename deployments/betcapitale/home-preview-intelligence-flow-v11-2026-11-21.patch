+/* CAPITALE Intelligence Flow v11
+   Stage design simulates the workflow; it does not show live data or actual results. */
+.cif-stage {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  box-sizing: border-box;
+  width: 100%;
+  max-width: 540px;
+  height: 505px;
+  padding: 21px 19px 17px;
+  border-radius: 24px;
+  border: 1px solid rgba(64,78,98,.9);
+  color: #F4F7FB;
+  background:
+    radial-gradient(ellipse 95% 58% at 50% 44%, rgba(30,71,118,.25) 0%, transparent 71%),
+    radial-gradient(ellipse 72% 35% at 83% 92%, rgba(234,116,25,.12) 0%, transparent 75%),
+    linear-gradient(151deg,#111824 0%,#10151e 49%,#090e16 100%);
+  box-shadow:
+    0 2px 3px rgba(5,13,27,.13),
+    0 14px 27px rgba(5,13,27,.15),
+    0 25px 48px -12px rgba(5,13,27,.13),
+    inset 0 1px rgba(255,255,255,.075);
+  font-family: "Manrope", Arial, sans-serif;
+}
+.cif-stage::before {
+  content:"";
+  position:absolute;
+  left:12%;
+  right:12%;
+  top:0;
+  height:1px;
+  background:linear-gradient(90deg,transparent,rgba(245,151,73,.73),rgba(255,255,255,.13),transparent);
+  z-index:5;
+}
+.cif-stage::after {
+  content:"";
+  position:absolute;
+  inset:0;
+  pointer-events:none;
+  opacity:.22;
+  background-image:radial-gradient(rgba(152,175,210,.27) .55px,transparent .55px);
+  background-size:22px 22px;
+  mask-image:linear-gradient(to bottom,transparent 10%,#000 48%,transparent 95%);
+  z-index:-1;
+}
+.cif-orbit {
+  position:absolute;
+  border-radius:50%;
+  pointer-events:none;
+  filter:blur(30px);
+  opacity:.27;
+  z-index:-1;
+}
+.cif-orbit-one {width:185px;height:155px;top:155px;left:20%;background:#234775;animation:cif-orbit-sway 9s ease-in-out infinite alternate;}
+.cif-orbit-two {width:165px;height:155px;top:265px;right:4%;background:#753a11;animation:cif-orbit-sway 11s ease-in-out infinite alternate-reverse;}
+@keyframes cif-orbit-sway {from{transform:translate(-10px,-8px) scale(.94)}to{transform:translate(8px,9px) scale(1.08)}}
+.cif-topline{height:19px;display:flex;align-items:center;justify-content:space-between;gap:8px;position:relative;z-index:2;}
+.cif-eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:9px;font-weight:850;letter-spacing:.13em;color:#CED8E8;white-space:nowrap;}
+.cif-eyebrow-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#F08026;box-shadow:0 0 12px rgba(242,119,29,.65);}
+.cif-concept-mark{font-size:8px;font-weight:800;letter-spacing:.12em;color:#DBA270;border:1px solid rgba(232,119,31,.3);border-radius:6px;padding:5px 7px;background:rgba(232,119,31,.08);white-space:nowrap;}
+.cif-sources {position:relative;z-index:2;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:17px;}
+.cif-source {
+  display:flex;
+  flex-direction:column;
+  align-items:center;
+  justify-content:center;
+  gap:5px;
+  box-sizing:border-box;
+  min-width:0;
+  height:85px;
+  padding:8px 3px;
+  border:1px solid #343F50;
+  border-radius:13px;
+  background:linear-gradient(155deg,rgba(43,57,77,.97),rgba(20,29,43,.97) 65%,rgba(15,22,33,.99));
+  box-shadow:0 5px 11px rgba(0,0,0,.23),inset 0 1px rgba(255,255,255,.12),inset 0 -1px rgba(0,0,0,.26);
+  animation:cif-input-focus 9s ease-in-out infinite;
+}
+.cif-source-news{animation-delay:3s;}
+.cif-source-analyst{animation-delay:6s;}
+@keyframes cif-input-focus {
+  0%,19%,100%{border-color:#343F50;box-shadow:0 5px 11px rgba(0,0,0,.23),inset 0 1px rgba(255,255,255,.12)}
+  8%{border-color:#9A643D;box-shadow:0 4px 13px rgba(0,0,0,.23),0 0 14px rgba(232,119,31,.15),inset 0 1px rgba(255,255,255,.15)}
+}
+.cif-source-icon {display:grid;place-items:center;color:#B4C9E4;}
+.cif-source-news .cif-source-icon{color:#D9BC98;}
+.cif-source-analyst .cif-source-icon{color:#B5C7DF;}
+.cif-source strong{color:#F5F6FA;font-size:12px;font-weight:900;letter-spacing:.045em;line-height:1;}
+.cif-source small{color:#9FABBE;font-size:7.4px;font-weight:750;letter-spacing:.02em;white-space:nowrap;line-height:1.3;}
+.cif-incoming-wires,.cif-outgoing-wires{position:relative;z-index:1;display:block;width:100%;overflow:visible;}
+.cif-incoming-wires{height:54px;}
+.cif-outgoing-wires{height:43px;}
+.cif-wire-base{stroke:#546B88;stroke-opacity:.65;stroke-width:1.35;fill:none;}
+.cif-wire-current{stroke:#F08A35;stroke-opacity:.78;stroke-width:1.55;fill:none;stroke-linecap:round;stroke-dasharray:4 16;animation:cif-wire-travel 2.5s linear infinite;}
+.cif-wire-current-delay{animation-delay:-.9s;}
+.cif-wire-current-delay-two{animation-delay:-1.6s;}
+@keyframes cif-wire-travel {from{stroke-dashoffset:0}to{stroke-dashoffset:-60}}
+.cif-moving-dot{fill:#FFAD6B;filter:drop-shadow(0 0 4px rgba(255,135,40,.95));}
+.cif-junction{fill:#E8771F;stroke:#FFD3B0;stroke-width:.6;filter:drop-shadow(0 0 4px rgba(244,119,33,.7));}
+.cif-engine {
+  display:flex;
+  position:relative;
+  z-index:2;
+  align-items:center;
+  gap:13px;
+  width:100%;
+  box-sizing:border-box;
+  height:119px;
+  padding:18px 16px;
+  border:1px solid rgba(232,119,31,.53);
+  border-radius:17px;
+  background:
+    radial-gradient(ellipse 70% 110% at 24% 45%,rgba(232,119,31,.14),transparent 85%),
+    linear-gradient(122deg,#24303e 0%,#192535 54%,#121b29 100%);
+  box-shadow:0 9px 22px rgba(0,0,0,.28),0 0 17px rgba(232,119,31,.065),inset 0 1px rgba(255,231,206,.16),inset 0 -1px rgba(0,0,0,.3);
+  animation:cif-engine-breathe 9s ease-in-out infinite;
+}
+@keyframes cif-engine-breathe{0%,100%{border-color:rgba(232,119,31,.46)}48%{border-color:rgba(255,155,75,.84)}}
+.cif-engine::before {
+  content:"";
+  position:absolute;
+  left:16px;right:16px;top:0;
+  height:1px;
+  background:linear-gradient(90deg,transparent,rgba(255,177,113,.48),transparent);
+}
+.cif-engine-emblem {
+  position:relative;display:grid;place-items:center;flex:0 0 68px;
+  width:68px;height:68px;border-radius:15px;
+  background:linear-gradient(150deg,rgba(232,119,31,.18),rgba(232,119,31,.05));
