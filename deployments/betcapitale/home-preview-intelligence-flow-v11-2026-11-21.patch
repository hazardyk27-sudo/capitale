+.cif-engine-emblem img{height:48px;width:48px;object-fit:contain;filter:drop-shadow(0 2px 8px rgba(232,119,31,.3));}
+.cif-engine-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:5px;}
+.cif-engine-meta{font-size:8px;letter-spacing:.12em;color:#E8A46B;font-weight:850;white-space:nowrap;}
