+++ b/client/src/components/DailyProfitTickerDemo.tsx
@@ -0,0 +1,94 @@
+import { ArrowDownRight, ArrowUpRight, BarChart3, CalendarDays } from "lucide-react";
+import "./daily-profit-ticker-demo.css";
+
+/**
+ * Visual-only homepage concept.
+ * IMPORTANT: All figures below are synthetic examples, NOT actual CAPITALE profits.
+ * Do not remove the visible DEMO DATA label before connecting to verified records.
+ */
+const sampleDays = [
+  { date: "19 NOV", day: "THU", coupons: 3, matches: 8, profit: 146 },
+  { date: "18 NOV", day: "WED", coupons: 2, matches: 6, profit: 84 },
+  { date: "17 NOV", day: "TUE", coupons: 4, matches: 11, profit: -36 },
+  { date: "16 NOV", day: "MON", coupons: 3, matches: 9, profit: 202 },
+  { date: "15 NOV", day: "SUN", coupons: 2, matches: 5, profit: 68 },
+  { date: "14 NOV", day: "SAT", coupons: 4, matches: 10, profit: -54 },
+  { date: "13 NOV", day: "FRI", coupons: 3, matches: 7, profit: 118 },
+  { date: "12 NOV", day: "THU", coupons: 2, matches: 6, profit: 92 },
+] as const;
+
+const formatProfit = (value: number) =>
+  `${value >= 0 ? "+" : "−"}€${Math.abs(value).toLocaleString("en-GB")}`;
+
+function DailyRow({ item }: { item: (typeof sampleDays)[number] }) {
+  const positive = item.profit >= 0;
+  return (
+    <div className="dpt-row" role="presentation">
+      <div className="dpt-date">
+        <strong>{item.date}</strong>
+        <span>{item.day}</span>
+      </div>
+      <div className="dpt-number">
+        <strong>{item.coupons}</strong>
+        <span>COUPONS</span>
+      </div>
+      <div className="dpt-number">
+        <strong>{item.matches}</strong>
+        <span>MATCHES</span>
+      </div>
+      <div className={`dpt-profit ${positive ? "is-positive" : "is-negative"}`}>
+        {positive ? <ArrowUpRight size={12} /> : <ArrowDownRight size={12} />}
+        <strong>{formatProfit(item.profit)}</strong>
+      </div>
+    </div>
+  );
+}
+
+export default function DailyProfitTickerDemo() {
+  return (
+    <section className="dpt-panel" aria-label="Example daily results animation">
+      <div className="dpt-heading">
+        <div className="dpt-heading-left">
+          <span className="dpt-symbol" aria-hidden="true">
+            <BarChart3 size={18} strokeWidth={1.9} />
+          </span>
+          <div className="dpt-heading-copy">
+            <span className="dpt-kicker">CAPITALE / PERFORMANCE</span>
+            <h2>Daily Results</h2>
+          </div>
+        </div>
+        <span className="dpt-demo-badge">DEMO DATA</span>
+      </div>
+
+      <div className="dpt-column-heading" aria-hidden="true">
+        <span><CalendarDays size={10} /> DATE</span>
+        <span>COUPONS</span>
+        <span>MATCHES</span>
+        <span>NET PROFIT</span>
+      </div>
+
+      <div className="dpt-viewport">
+        <div className="dpt-scroll-track" aria-hidden="true">
+          {[0, 1].map((copyIndex) => (
+            <div key={copyIndex} className="dpt-row-group">
+              {sampleDays.map((day) => (
+                <DailyRow key={`${copyIndex}-${day.date}`} item={day} />
+              ))}
+            </div>
+          ))}
+        </div>
+      </div>
+
+      <div className="dpt-footer">
+        <span className="dpt-footer-dot" aria-hidden="true" />
+        <span>Example daily performance</span>
+        <span className="dpt-footer-divider" aria-hidden="true" />
+        <span>Illustrative figures · Not actual results</span>
+      </div>
+      <p className="dpt-visually-hidden">
+        This panel displays sample, fictional daily results to demonstrate the design.
+        These are not historical or verified CAPITALE returns.
+      </p>
+    </section>
+  );
+}
