 // Match List v2 metrics are derived from the authenticated Software feed.
 // Never copy stale manual browser values or demo rows into live match graphics.
 const NO_MATCH_LIST_V2_DATA: Record<number,MatchListTemplate2Metrics> = {};
+
+// Visual DEMO ONLY: deterministic sample values for story/post mockups.
+// They never enter Software API, DB, research records, or verified summaries.
+// Fixture names, kickoff times and actual result statuses remain untouched.
+function sampleMatchList2Metric(match:TM, real:MatchListTemplate2Metrics | undefined):MatchListTemplate2Metrics {
+  const text=`${match.date}|${match.homeTeam}|${match.awayTeam}`;
+  let hash=2166136261;
+  for (const c of text) {hash=Math.imul(hash^c.charCodeAt(0),16777619)>>>0;}
+  const sample=(salt:number,lo:number,hi:number)=>{
+    let n=(hash^Math.imul(salt,2654435761))>>>0;
+    n=Math.imul(n^(n>>>16),2246822507)>>>0;
+    n=Math.imul(n^(n>>>13),3266489909)>>>0;
+    return lo+n%(hi-lo+1);
+  };
+  const code=['PRM-6','MOM-8','STR-6','SLD-8','CRL-6','CNI-6','PRM-8'][sample(1,0,6)];
+  const direction=sample(2,0,1)===0?'-':'+';
+  return {
+    status:'missing',reason:'DEMO SAMPLE ONLY — no Software verification',
+    signal:code,checkpoint:code.endsWith('-8')?'T-8':'T-6',
+    analyst:String(sample(3,61,92)),
+    volume:`${(sample(4,670,975)/10).toFixed(1)}%`,
+    news:String(sample(5,55,88)),
+    draw:`${(sample(6,30,215)/10).toFixed(1)}%`,
+    movement:`${direction}${(sample(7,2,69)/10).toFixed(1)}%`,
+    market:'',selection:'',
+    homeLogoUrl:real?.homeLogoUrl??null,awayLogoUrl:real?.awayLogoUrl??null,
+  };
+}
 
