+/**
+ * DEMO ONLY: wholly fictional fixtures, selections and ticket returns.
+ * NEVER use as actual match predictions, bookmaker odds, settlements, or P&L.
+ */
+export const demoMatches = [
+  { id: "M01", fixture: "Chelsea — Arsenal", pick: "Full Time 1", won: true },
+  { id: "M02", fixture: "Barcelona — Elche", pick: "Over 3.5 Goals", won: true },
+  { id: "M03", fixture: "Roma — Inter", pick: "BTTS Yes", won: false },
+  { id: "M04", fixture: "Bayern — Mainz", pick: "Over 2.5 Goals", won: true },
+] as const;
+
+export const demoCoupons = [
+  { id: "A", matchIds: ["M01", "M02"], stake: 20, returned: 58 },
+  { id: "B", matchIds: ["M02", "M04"], stake: 20, returned: 48 },
+  { id: "C", matchIds: ["M01", "M03"], stake: 20, returned: 0 },
+] as const;
+
+export const demoTotals = {
+  staked: demoCoupons.reduce((sum, coupon) => sum + coupon.stake, 0),
+  returned: demoCoupons.reduce((sum, coupon) => sum + coupon.returned, 0),
+  won: demoCoupons.filter((coupon) => coupon.returned > 0).length,
+  lost: demoCoupons.filter((coupon) => coupon.returned === 0).length,
+};
+export const demoNet = demoTotals.returned - demoTotals.staked;
+
+export const demoMatchLookup: Record<string, (typeof demoMatches)[number]> =
+  Object.fromEntries(demoMatches.map((match) => [match.id, match]));
