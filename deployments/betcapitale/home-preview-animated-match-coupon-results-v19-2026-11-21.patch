+import assert from "node:assert/strict";
+import test from "node:test";
+import { demoCoupons, demoMatchLookup, demoMatches, demoNet, demoTotals } from "./intelligence-flow-sample";
+
+test("sample coupon settlement is arithmetically consistent", () => {
+  assert.equal(demoTotals.staked, 60);
+  assert.equal(demoTotals.returned, 106);
+  assert.equal(demoNet, 46);
+  assert.equal(demoTotals.won, 2);
+  assert.equal(demoTotals.lost, 1);
+  assert.equal(demoMatches.length, 4);
+});
+
+test("each coupon references actual example selections", () => {
+  for (const coupon of demoCoupons) {
+    assert.equal(coupon.matchIds.length, 2);
+    assert.ok(coupon.matchIds.every((id) => Boolean(demoMatchLookup[id])));
+    const ticketWon = coupon.matchIds.every((id) => demoMatchLookup[id]?.won);
+    assert.equal(coupon.returned > 0, ticketWon);
+  }
+});
+
+test("example three illustrates losing combo and correct negative net per coupon", () => {
+  const lostCoupon = demoCoupons.find((c) => c.id === "C");
+  assert.ok(lostCoupon);
+  assert.equal(lostCoupon.returned - lostCoupon.stake, -20);
+  assert.equal(demoCoupons.reduce((sum, c) => sum + (c.returned - c.stake), 0), demoNet);
+});
